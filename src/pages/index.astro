---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE + ' | Sports, TV, Celebrity and Crime News Explained'}
			description={SITE_DESCRIPTION}
		/>
		<style>
			.intro h1 {
				margin-bottom: 0.25em;
			}
			.sections {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				list-style: none;
				padding: 0;
			}
			.sections a {
				display: inline-block;
				padding: 0.3em 0.9em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				text-decoration: none;
				font-size: 0.9em;
			}
			.more {
				margin-top: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>
					The stories everyone is talking about in sports, TV and streaming, celebrity news and
					crime and justice, explained clearly, with links to the sources.
				</p>
				<ul class="sections">
					{
						Object.entries(CATEGORIES).map(([slug, name]) => (
							<li>
								<a href={'/category/' + slug + '/'}>{name}</a>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>Latest</h2>
				<ArticleList posts={posts} />
				<p class="more"><a href="/blog/">All news →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
