---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleList from '../../components/ArticleList.astro';
import { SITE_TITLE, CATEGORIES } from '../../consts';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
	return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const name = CATEGORIES[category as string];
const posts = (
	await getCollection('blog', ({ data }) => !data.draft && data.category === category)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={name + ' News | ' + SITE_TITLE}
			description={'The latest ' + name + ' stories from ' + SITE_TITLE + ', explained with sources.'}
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>{name}</h1>
			<ArticleList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
