---
import { SITE_TITLE, CATEGORIES } from '../consts';

const path = Astro.url.pathname;
---

<header>
	<nav>
		<h2><a href="/"><img class="site-logo" src="/logo.png" alt="Headline Buzz logo" />{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<a href="/" class:list={[{ active: path === '/' }]}>Home</a>
			{
				Object.entries(CATEGORIES).map(([slug, name]) => (
					<a
						href={'/category/' + slug + '/'}
						class:list={[{ active: path.startsWith('/category/' + slug) }]}
					>
						{name}
					</a>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		text-decoration: none;
	}
	.site-logo {
		height: 2em;
		width: auto;
		vertical-align: -0.5em;
		margin-right: 0.4em;
		border-radius: 4px;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		font-weight: bolder;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		nav a {
			padding: 0.6em 0.4em;
			font-size: 0.85em;
		}
	}
</style>
